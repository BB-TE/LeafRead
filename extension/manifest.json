{
  "manifest_version": 3,
  "name": "LeafRead · 网页查词",
  "version": "0.5.0",
  "minimum_chrome_version": "120",
  "description": "读英文时悬浮查词，也可以输入单词查询；收藏单词及原句到本地生词本。",
  "action": { "default_title": "LeafRead · 网页悬浮查词", "default_popup": "popup.html" },
  "permissions": ["storage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["core.js", "shared.js", "web-text.js", "web-content.js"],
    "css": ["web-content.css"],
    "run_at": "document_idle",
    "all_frames": true,
    "match_origin_as_fallback": true
  }],
  "host_permissions": ["https://dict.youdao.com/*", "https://api.mymemory.translated.net/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
